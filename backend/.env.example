# --- MEANREV Backend .env.example ---
# Copy to .env: cp .env.example .env
# Never commit .env — it is gitignored. This file is the template.
# LLM provider: choose ONE of OpenRouter / Groq / Modal (or direct APIs as fallback)
# Models: selector per agent — system uses these values (see core/config.py)

# Alpaca Paper Trading (required)
ALPACA_API_URL=https://paper-api.alpaca.markets/v2
ALPACA_API_KEY=YOUR_PAPER_API_KEY_HERE
ALPACA_API_SECRET=YOUR_PAPER_SECRET_HERE

# LLM Provider selection
# Options: openrouter | groq | modal
LLM_PROVIDER=openrouter

# OpenRouter — unified gateway for Claude 3.5 Sonnet + GPT-4o + others
# Get key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Groq — fast inference for open models (e.g., Llama, Mixtral)
# Get key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Modal — serverless GPU for custom/hosted models
# Get tokens at https://modal.com/settings/tokens -> modal token new --profile=yaligarabhishek6
# For this project (GLM-5.3 proxy via Modal):
#   Endpoint ID: ep-Ue2TlinRcqHUly46fnVi3Z
#   Endpoint URL: https://yaligarabhishek6--ep-glm-5-3-server.us-west.modal.direct
#   Proxy: Authorization: Bearer <MODAL_PROXY_TOKEN>  (see below, never commit real token)
# Setup (local, do NOT commit .env):
#   modal token set --token-id YOUR_TOKEN_ID --token-secret YOUR_TOKEN_SECRET --profile=yaligarabhishek6
#   modal profile activate yaligarabhishek6
MODAL_TOKEN_ID=YOUR_MODAL_TOKEN_ID_HERE
MODAL_TOKEN_SECRET=YOUR_MODAL_TOKEN_SECRET_HERE
MODAL_ENVIRONMENT=main
# Modal GLM endpoint (GLM-5.3) — custom proxy for this workspace
MODAL_ENDPOINT_ID=ep-Ue2TlinRcqHUly46fnVi3Z
MODAL_ENDPOINT_URL=https://yaligarabhishek6--ep-glm-5-3-server.us-west.modal.direct
# Modal proxy auth — requests must include Authorization: Bearer <proxy_token>
# Generate/use your proxy token; keep in backend/.env only (gitignored), never commit
MODAL_PROXY_TOKEN_ID=YOUR_MODAL_PROXY_TOKEN_ID_HERE
MODAL_PROXY_TOKEN=YOUR_MODAL_PROXY_BEARER_TOKEN_HERE

# Direct provider keys — fallback if not using OpenRouter/Groq/Modal gateway
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model selectors — single source of truth for all agents
# These are the values the app reads at startup; change here to swap models
# without touching code. Use OpenRouter naming when LLM_PROVIDER=openrouter.
# Examples:
#   OpenRouter: anthropic/claude-3.5-sonnet, openai/gpt-4o, google/gemini-1.5-pro, meta-llama/llama-3.1-70b-instruct
#   Groq:       llama-3.1-70b-versatile, mixtral-8x7b-32768, llama3-70b-8192
#   Modal:      your-modal-app/model-name
LLM_MODEL_MARKET_RESEARCH=anthropic/claude-3.5-sonnet
LLM_MODEL_STRATEGY=openai/gpt-4o
LLM_MODEL_REPORTING=openai/gpt-4o-mini
# Optional overrides per environment — leave empty to use defaults above
# LLM_MODEL_MARKET_RESEARCH_DEV=
# LLM_MODEL_STRATEGY_DEV=

# Risk thresholds — deterministic, no hardcoded logic in agents (all via .env)
# Max single position as fraction of equity (0.15 = 15%)
RISK_MAX_POSITION_PCT=0.15
# Max gross exposure as fraction of equity (0.60 = 60%)
RISK_MAX_EXPOSURE_PCT=0.60
# Daily drawdown trigger fraction (0.03 = 3% → auto-pause, require CLI /resume)
RISK_DAILY_DRAWDOWN_PCT=0.03
# Peak equity for drawdown calc; if empty, uses current portfolio_value as peak (auto-tracked)
# RISK_PEAK_EQUITY=100000

# Execution modes — auto (autonomous, no HITL) vs hitl (human approval via interrupt)
# For scoring window Aug 31 9:30 ET, use auto; for dry-run large orders, use hitl
EXECUTION_MODE=auto
HITL_ENABLED=false
# HITL_ALLOWED_DECISIONS=approve,edit,reject

# Alpaca MCP Server / CLI — Phase 12 bonus (at least one required in addition to Trading API)
# Option A: MCP Server via SSE URL (e.g. self-hosted or npx bridge)
# MCP_SERVER_URL=http://localhost:3000/sse
# ALPACA_MCP_SERVER_URL=http://localhost:3000/sse
# Option B: MCP Server via stdio command (e.g. npx @alpacahq/alpaca-mcp-server)
# MCP_SERVER_COMMAND=npx -y @alpacahq/alpaca-mcp-server
# ALPACA_MCP_COMMAND=npx -y @alpacahq/alpaca-mcp-server
# Alpaca CLI is auto-detected via `alpaca` binary; no env needed but ensure `pip install alpaca-trade-api` and `alpaca --version` works
# See backend/mcp/server_config.example.json and backend/tools/alpaca_cli_tool.py

# Scheduler — Phase 12b autonomous loop (ticks every interval when market open, persists to logs/scheduler.json)
# For scoring window Aug 31 9:30 ET unattended, set SCHEDULER_ENABLED=true and run: meanrev --scheduler
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MIN=5
SCHEDULER_THREAD_ID=scheduler
SCHEDULER_PROMPT=Do Research On BTC/USD And Propose a Order
# Alternative: SCHEDULER_PROMPT=Analyze SPY and propose a trade with options
