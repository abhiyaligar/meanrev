# Meanrev — copy to .env: cp .env.example .env (never commit .env)
# Required: Alpaca Paper + one LLM provider + FRED (free). Others optional.

# --- Alpaca Paper Trading (required) ---
ALPACA_API_URL=https://paper-api.alpaca.markets/v2
ALPACA_API_KEY=YOUR_PAPER_API_KEY
ALPACA_API_SECRET=YOUR_PAPER_API_SECRET

# --- LLM Provider (pick one) ---
# openrouter | groq | modal
LLM_PROVIDER=openrouter

# OpenRouter (gateway for Claude/GPT/Gemini) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Groq (fast open models) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Modal (hosted GLM-5.3 proxy) — modal token new --profile=yaligarabhishek6
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_ENVIRONMENT=main
MODAL_ENDPOINT_ID=ep-Ue2TlinRcqHUly46fnVi3Z
MODAL_ENDPOINT_URL=https://yaligarabhishek6--ep-glm-5-3-server.us-west.modal.direct
MODAL_PROXY_TOKEN=

# Direct fallbacks (optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Models (single source, change here to swap) ---
LLM_MODEL_MARKET_RESEARCH=anthropic/claude-3.5-sonnet
LLM_MODEL_STRATEGY=openai/gpt-4o
LLM_MODEL_REPORTING=openai/gpt-4o-mini

# --- Risk (deterministic, no hardcoded logic) ---
RISK_MAX_POSITION_PCT=0.15
RISK_MAX_EXPOSURE_PCT=0.60
RISK_DAILY_DRAWDOWN_PCT=0.03

# --- Execution ---
EXECUTION_MODE=auto
HITL_ENABLED=false

# --- Scheduler (autonomous loop, market-hours aware; crypto bypasses) ---
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MIN=5
SCHEDULER_THREAD_ID=scheduler
SCHEDULER_PROMPT=Do Research On BTC/USD And Propose a Order

# --- Macro Data (free, no mock) ---
# FRED: https://fred.stlouisfed.org/docs/api/api_key.html
# Finnhub: https://finnhub.io/register (60/min free)
FRED_API_KEY=YOUR_FRED_API_KEY
FRED_API_URL=https://api.stlouisfed.org/fred
FRED_CSV_URL=https://fred.stlouisfed.org/graph/fredgraph.csv
FINNHUB_API_KEY=YOUR_FINNHUB_API_KEY
BLS_API_KEY=

# --- MCP / CLI (bonus, at least one) ---
# MCP_SERVER_URL=http://localhost:3000/sse
# MCP_SERVER_COMMAND=npx -y @alpacahq/alpaca-mcp-server
