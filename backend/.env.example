# --- MEANREV Backend .env.example ---
# Copy to .env: cp .env.example .env
# Never commit .env — it is gitignored. This file is the template.
# LLM provider: choose ONE of OpenRouter / Groq / Modal (or direct APIs as fallback)
# Models: selector per agent — system uses these values (see core/config.py)

# Alpaca Paper Trading (required)
ALPACA_API_URL=https://paper-api.alpaca.markets/v2
ALPACA_API_KEY=YOUR_PAPER_API_KEY_HERE
ALPACA_API_SECRET=YOUR_PAPER_SECRET_HERE

# LLM Provider selection
# Options: openrouter | groq | modal
LLM_PROVIDER=openrouter

# OpenRouter — unified gateway for Claude 3.5 Sonnet + GPT-4o + others
# Get key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Groq — fast inference for open models (e.g., Llama, Mixtral)
# Get key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Modal — serverless GPU for custom/hosted models
# Get tokens at https://modal.com/settings/tokens
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_ENVIRONMENT=main

# Direct provider keys — fallback if not using OpenRouter/Groq/Modal gateway
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model selectors — single source of truth for all agents
# These are the values the app reads at startup; change here to swap models
# without touching code. Use OpenRouter naming when LLM_PROVIDER=openrouter.
# Examples:
#   OpenRouter: anthropic/claude-3.5-sonnet, openai/gpt-4o, google/gemini-1.5-pro, meta-llama/llama-3.1-70b-instruct
#   Groq:       llama-3.1-70b-versatile, mixtral-8x7b-32768, llama3-70b-8192
#   Modal:      your-modal-app/model-name
LLM_MODEL_MARKET_RESEARCH=anthropic/claude-3.5-sonnet
LLM_MODEL_STRATEGY=openai/gpt-4o
LLM_MODEL_REPORTING=openai/gpt-4o-mini
# Optional overrides per environment — leave empty to use defaults above
# LLM_MODEL_MARKET_RESEARCH_DEV=
# LLM_MODEL_STRATEGY_DEV=

# Risk thresholds — deterministic, no hardcoded logic in agents (all via .env)
# Max single position as fraction of equity (0.15 = 15%)
RISK_MAX_POSITION_PCT=0.15
# Max gross exposure as fraction of equity (0.60 = 60%)
RISK_MAX_EXPOSURE_PCT=0.60
# Daily drawdown trigger fraction (0.03 = 3% → auto-pause, require CLI /resume)
RISK_DAILY_DRAWDOWN_PCT=0.03
# Peak equity for drawdown calc; if empty, uses current portfolio_value as peak (auto-tracked)
# RISK_PEAK_EQUITY=100000

# Execution modes — auto (autonomous, no HITL) vs hitl (human approval via interrupt)
# For scoring window Aug 31 9:30 ET, use auto; for dry-run large orders, use hitl
EXECUTION_MODE=auto
HITL_ENABLED=false
# HITL_ALLOWED_DECISIONS=approve,edit,reject
